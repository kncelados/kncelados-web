# Copia este fichero a `.env` y rellena los valores.
# Sin estos valores, el formulario de /contacto responde 503 (no rompe el site).

# API key de Resend: https://resend.com/api-keys
RESEND_API_KEY=

# Email de destino de los mensajes del formulario (email comercial de KNCELADOS).
CONTACT_EMAIL=

# Remitente verificado en Resend para el from del correo.
# Opcional: si se omite, se usa `Kncelados Web <CONTACT_EMAIL>`.
CONTACT_FROM_EMAIL=
---
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/Link.astro";
---

<Fragment slot="head">
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.kncelados.com/descargas" />
  <meta property="og:title" content="Descargas | Kncelados" />
  <meta
    property="og:description"
    content="Descarga nuestros PDFs con arte oficial de Kncelados. Material listo para compartir, imprimir y usar en tus redes."
  />
  <meta property="og:image" content="https://www.kncelados.com/logo-512.png" />
  <meta name="twitter:title" content="Descargas | Kncelados" />
  <meta
    name="twitter:description"
    content="Descarga nuestros PDFs con arte oficial de Kncelados. Material listo para compartir, imprimir y usar en tus redes."
  />
  <meta name="twitter:image" content="https://www.kncelados.com/logo-512.png" />
  <link rel="canonical" href="https://www.kncelados.com/descargas" />
</Fragment>

<Layout
  title="Descargas | Kncelados"
  description="Descarga nuestros PDFs con arte oficial de Kncelados. Material listo para compartir, imprimir y usar en tus redes."
>
  <section
    class="flex min-h-[80vh] flex-1 flex-col items-center gap-8 px-4 pb-40 text-center"
  >
    <h1 class="mt-48 max-w-3xl text-2xl lg:text-4xl">Descargas</h1>

    <p class="max-w-3xl text-lg text-dark-200 lg:text-xl">
      Descarga nuestros PDFs con arte oficial de Kncelados. Material listo para
      compartir, imprimir y usar.
    </p>

    <div class="mt-12 grid w-full max-w-6xl gap-4 sm:grid-cols-2">
      <article
        class="flex items-center overflow-hidden rounded-3xl border border-dark-50/10 bg-dark-50/5"
      >
        <div
          class="flex min-h-[320px] w-full flex-col items-center lg:min-h-[200px] lg:flex-row"
        >
          <div
            class="flex h-64 w-full items-center justify-center p-4 lg:h-auto lg:w-1/2"
          >
            <img
              src="/descargas/no-vendo.webp"
              alt="Vista previa No Vendo"
              class="max-h-full max-w-full object-contain"
            />
          </div>
          <div
            class="flex w-full flex-1 flex-col items-center justify-center p-8 text-center lg:items-start lg:justify-start lg:text-left"
          >
            <p class="text-2xl font-sans">No Vendo</p>
            <div class="mt-6">
              <Link
                href="/descargas/no-vendo.pdf"
                label="Descargar PDF"
                download
              />
            </div>
          </div>
        </div>
      </article>

      <article
        class="flex items-center overflow-hidden rounded-3xl border border-dark-50/10 bg-dark-50/5"
      >
        <div
          class="flex min-h-[320px] w-full flex-col items-center lg:min-h-[200px] lg:flex-row"
        >
          <div
            class="flex h-64 w-full items-center justify-center p-4 lg:h-64 lg:w-1/2"
          >
            <img
              src="/descargas/yoaparcomal.webp"
              alt="Vista previa Yo Aparco Mal"
              class="max-h-full max-w-full object-contain"
            />
          </div>
          <div
            class="flex w-full flex-1 flex-col items-center justify-center p-8 text-center lg:items-start lg:justify-start lg:text-left"
          >
            <p class="text-2xl font-sans">Yo Aparco Mal</p>
            <div class="mt-6">
              <Link
                href="/descargas/yoaparcomal.pdf"
                label="Descargar PDF"
                download
              />
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import {
  ArrowRight,
  Clapperboard,
  MessageSquare,
  Share2,
  Sparkles,
} from "@lucide/astro";
import Instagram from "@/lib/assets/Instagram.astro";
import Tiktok from "@/lib/assets/Tiktok.astro";
import Youtube from "@/lib/assets/Youtube.astro";
import Facebook from "@/lib/assets/Facebook.astro";
import Spotify from "@/lib/assets/Spotify.astro";
import {
  audienceFacts,
  collabConcepts,
  collabPhilosophyAccent,
  collabPhilosophyLead,
  platformFollowers,
  spotifyMetric,
  totalFollowers,
} from "@/lib/commercial";

const platformMeta = {
  instagram: { Icon: Instagram, label: "Instagram" },
  tiktok: { Icon: Tiktok, label: "TikTok" },
  youtube: { Icon: Youtube, label: "YouTube" },
  facebook: { Icon: Facebook, label: "Facebook" },
} as const;

const formatFollowers = (n: number): string => {
  if (n >= 1_000_000) {
    const v = n / 1_000_000;
    const s = Number.isInteger(v) ? v.toFixed(0) : v.toFixed(1);
    return s.replace(".", ",") + "M";
  }
  return Math.round(n / 1_000) + "K";
};

const totalLabel = formatFollowers(totalFollowers);

const factRotations = ["rotate-1", "-rotate-1", "rotate-2", "-rotate-2"];
const conceptRotations = ["-rotate-1", "rotate-1", "rotate-2", "-rotate-2"];
const conceptIcons = [Clapperboard, Share2, Sparkles, MessageSquare];
---

<Layout
  title="Colabora | Kncelados"
  description="¿Quieres meter tu marca en la conversación de KNCELADOS? Un podcast de humor sin filtros con más de 1M de seguidores, episodios de +90 minutos y una comunidad que se queda. Escríbenos a hola@kncelados.com."
>
  <section
    class="relative flex w-full flex-col items-center gap-16 px-6 pt-44 pb-28 lg:px-12 lg:pt-56 lg:pb-36"
  >
    <div class="flex flex-col items-center gap-6 text-center">
      <h1 class="text-5xl leading-[0.95] tracking-tight sm:text-6xl lg:text-8xl">
        TU MARCA<br />TAMBIÉN TIENE<br /><span class="text-knc-600">SITIO</span> AQUÍ
      </h1>
      <p class="max-w-xl font-sans text-lg leading-relaxed text-dark-50/80 lg:text-2xl">
        No queremos que tu marca parezca un anuncio. Queremos que parezca una de
        las nuestras.
      </p>
    </div>

    <div class="relative w-full max-w-3xl">
      <img
        src="/foto-colabora.png"
        alt="El equipo de Kncelados"
        class="aspect-video w-full rotate-1 rounded-3xl border border-white/15 object-cover shadow-[0_24px_60px_-24px_rgb(0_0_0/0.8)]"
      />
    </div>
  </section>

  <section
    class="flex w-full flex-col items-center gap-8 border-y border-white/10 bg-white/[0.02] px-6 py-20 lg:gap-12 lg:py-28"
  >
    <h2 class="text-center text-3xl lg:text-6xl">
      NUESTROS<br />NÚMEROS
    </h2>

    <div
      class="grid w-full max-w-5xl grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4 lg:gap-6"
    >
      {
        platformFollowers.map(({ id, followers }) => {
          const { Icon, label } = platformMeta[id];
          return (
            <div
              class="flex flex-col items-center gap-2 rounded-2xl border border-white/10 bg-black/20 px-4 py-5 lg:gap-3 lg:rounded-3xl lg:p-6"
            >
              <Icon class="size-5 text-dark-50/80 lg:size-8" />
              <p class="font-title text-4xl sm:text-3xl lg:text-5xl">
                {formatFollowers(followers)}
              </p>
              <p
                class="font-sans text-[10px] uppercase tracking-wide text-dark-50/60 lg:text-sm"
              >
                {label}
              </p>
            </div>
          );
        })
      }
    </div>

    <div
      class="flex w-full max-w-5xl items-center justify-center gap-3 rounded-3xl border border-knc-600/40 bg-knc-600/10 px-10 py-8"
    >
      <p class="font-title text-4xl lg:text-6xl">+{totalLabel}</p>
      <p class="font-title text-4xl text-knc-600 lg:text-6xl">SEGUIDORES</p>
    </div>

    <div class="flex flex-col items-center gap-2 text-center">
      <div class="flex items-center gap-2">
        <Spotify class="size-5 text-dark-50/70" />
        <p class="font-title text-lg lg:text-xl">
          {spotifyMetric.value}{" "}
          <span class="text-sm text-dark-50/60 lg:text-base">
            {spotifyMetric.label}
          </span>
        </p>
        {
          spotifyMetric.dynamic && (
            <p class="font-hand text-xl text-knc-600">y sigue subiendo ↑</p>
          )
        }
      </div>
      <p class="font-sans text-xs text-dark-50/50">
        Spotify no suma al total: son escuchas, no seguidores. Se actualiza
        cuando cambian.
      </p>
    </div>
  </section>

  <section
    class="flex w-full flex-col items-center gap-8 px-6 py-20 lg:gap-12 lg:py-28"
  >
    <div class="flex flex-col items-center gap-1 text-center">
      <h2 class="max-w-3xl text-3xl lg:text-6xl">
        QUIÉN SE QUEDA<br />A ESCUCHARNOS
      </h2>
      <p class="font-hand rotate-1 text-2xl text-knc-600 lg:text-3xl">
        esto no son followers, es público real
      </p>
    </div>

    <ul
      class="grid w-full max-w-5xl grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6"
    >
      {
        audienceFacts.map((fact, i) => (
          <li
            class={`flex flex-col gap-2 rounded-3xl border border-white/10 bg-white/[0.03] p-6 ${factRotations[i % factRotations.length]}`}
          >
            <p class="font-hand text-4xl text-knc-600 lg:text-5xl">
              {fact.title}
            </p>
            <p class="font-sans text-sm leading-relaxed text-dark-50/70">
              {fact.desc}
            </p>
            {
              fact.confirmed && (
                <p
                  class="mt-auto pt-3 font-sans text-[10px] uppercase tracking-widest text-dark-50/40"
                >
                  dato del MediaKit 2026
                </p>
              )
            }
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="flex w-full flex-col items-center gap-10 border-y border-white/10 bg-white/[0.02] px-6 py-20 lg:gap-14 lg:py-28"
  >
    <h2 class="max-w-3xl text-center text-3xl lg:text-6xl">
      QUÉ PODEMOS<br />HACER <span class="text-knc-600">JUNTOS</span>
    </h2>

    <ul
      class="grid w-full max-w-5xl grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6"
    >
      {
        collabConcepts.map(({ title, desc }, i) => {
          const Icon = conceptIcons[i % conceptIcons.length];
          return (
            <li
              class={`group flex flex-col gap-4 rounded-3xl border border-white/10 bg-black/20 p-6 ${conceptRotations[i % conceptRotations.length]}`}
            >
              <span
                class="flex size-12 items-center justify-center rounded-full bg-knc-600 text-dark-950"
              >
                <Icon class="size-6" />
              </span>
              <div class="flex flex-col gap-2">
                <h3 class="text-lg lg:text-xl">{title}</h3>
                <p class="font-sans text-sm leading-relaxed text-dark-50/70">
                  {desc}
                </p>
              </div>
            </li>
          );
        })
      }
    </ul>

    <blockquote class="max-w-3xl text-center">
      <p
        class="font-hand -rotate-1 text-4xl leading-[1.05] text-dark-50 lg:text-6xl"
      >
        “{collabPhilosophyLead}{" "}
        <span class="text-knc-600">{collabPhilosophyAccent}”</span>
      </p>
    </blockquote>
  </section>

  <section
    class="flex w-full flex-col items-center gap-8 px-6 py-24 lg:gap-10 lg:py-36"
  >
    <div class="flex flex-col items-center gap-4 lg:flex-row lg:gap-6">
      <a
        href="mailto:hola@kncelados.com"
        class="inline-flex items-center gap-4 rounded-full bg-knc-600 px-12 py-5 text-2xl text-dark-50 uppercase transition-transform duration-300 hover:-rotate-2 hover:scale-105 lg:px-16 lg:py-6 lg:text-3xl"
      >
        Contactar <ArrowRight class="size-6 lg:size-7" />
      </a>
      <a
        href="mailto:hola@kncelados.com"
        class="font-sans text-lg text-dark-50/70 transition-colors hover:text-dark-50 lg:text-xl"
      >
        hola@kncelados.com
      </a>
    </div>
  </section>
</Layout>
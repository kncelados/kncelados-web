---
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/Link.astro";
import {
  ArrowRight,
  CalendarDays,
  Clapperboard,
  MessageSquare,
  Mic,
  Package,
  Share2,
  Sparkles,
  Zap,
} from "@lucide/astro";
import { formats } from "@/lib/commercial";

const icons = [
  Clapperboard,
  Mic,
  Package,
  Sparkles,
  Share2,
  CalendarDays,
  Zap,
  MessageSquare,
];
---

<Layout
  title="Colabora | Kncelados"
  description="¿Quieres meter tu marca en la conversación de KNCELADOS? Patrocinio, integración de producto, branded content y clips. Hablamos."
>
  <section class="relative flex min-h-[80vh] flex-col items-center justify-center gap-8 px-6 pt-40 pb-24 text-center">
    <p class="font-title text-lg text-knc-600 lg:text-xl">[ Colabora ]</p>
    <h1 class="max-w-4xl text-5xl leading-tight lg:text-9xl">¿HABLAMOS?</h1>
    <p class="max-w-2xl font-sans text-lg text-dark-50/80 lg:text-2xl">
      No somos una agencia. Somos un podcast de humor sin filtros que la gente
      se ve en serio. METE TU MARCA EN LA CONVERSACIÓN, sin guion corporativo y
      sin corbata.
    </p>
    <a
      href="#formulario"
      class="mt-4 rounded-full bg-knc-600 px-10 py-3.5 text-lg text-dark-50 uppercase transition-transform duration-300 hover:-rotate-2 hover:scale-105"
    >
      Cuéntanos tu idea
    </a>
  </section>

  <section class="flex w-full flex-col items-center gap-4 px-6 pb-8 lg:gap-8">
    <h2 class="max-w-3xl text-center text-3xl lg:text-6xl">
      QUÉ PODEMOS<br />HACER JUNTOS
    </h2>

    <ul class="mt-4 grid w-full max-w-5xl grid-cols-1 gap-4 sm:grid-cols-2 lg:gap-6">
      {
        formats.map(({ label, desc }, i) => {
          const Icon = icons[i % icons.length];
          return (
            <li
              class="group flex items-start gap-5 rounded-3xl border border-white/10 bg-white/[0.03] p-6 transition-colors hover:border-knc-600/60"
            >
              <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-knc-600 text-dark-950">
                <Icon class="size-6" />
              </span>
              <div class="flex flex-col gap-1">
                <h3 class="text-lg lg:text-xl">{label}</h3>
                <p class="font-sans text-sm leading-relaxed text-dark-50/70">
                  {desc}
                </p>
              </div>
            </li>
          );
        })
      }
    </ul>

    <p class="max-w-xl pt-4 text-center font-sans text-sm text-dark-50/60">
      Los formatos y las condiciones se confirman caso a caso, con el presupuesto
      encima de la mesa. ¿Estás pensando en otra cosa? Cuéntanos: no hacemos solo
      esto, pero esto es con lo que más nos divertimos.
    </p>
  </section>

  <section class="flex w-full flex-col items-center gap-6 px-6 py-20 lg:py-32">
    <h2 class="text-center text-3xl lg:text-6xl">
      ¿QUIERES TODOS<br />LOS DATOS?
    </h2>
    <div class="flex flex-col items-center gap-6">
      <Link
        href="/knc-media-kit-publico-2026.pdf"
        label="DESCARGAR MEDIA KIT (2026)"
        bgColor="bg-knc-600"
        textColor="text-dark-950"
        download
      />
      <p class="text-center font-sans text-xs text-dark-50/50">
        Cifras y formatos de la temporada 4, sin los precios de la versión de
        negociación. ¿Los quieres completos? Escríbenos a{" "}
        <a
          href="mailto:hola@kncelados.com"
          class="text-knc-600 hover:underline"
        >
          hola@kncelados.com
        </a>
        .
      </p>
    </div>
  </section>

  <section
    id="formulario"
    class="flex w-full flex-col items-center gap-8 border-t border-white/10 px-6 py-20 lg:py-32"
  >
    <h2 class="text-center text-3xl lg:text-6xl">
      HABLEMOS SIN<br /><span class="text-knc-600">[</span>COMPROMISO
      <span class="text-knc-600">]</span>
    </h2>
    <p class="max-w-xl text-center font-sans text-dark-50/70">
      Cuatro campos y te pedimos que no nos cuentes tu plan de negocio. Si hay
      feeling, lo hablamos en 48 h.
    </p>

    <form
      id="contact-form"
      class="mt-4 flex w-full max-w-xl flex-col gap-4"
      novalidate
    >
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="flex flex-col gap-2">
          <label for="nombre" class="font-title text-sm uppercase">
            Tu nombre
          </label>
          <input
            id="nombre"
            name="nombre"
            type="text"
            required
            placeholder="Como en el grupo de WhatsApp"
            class="rounded-2xl border border-white/15 bg-white/[0.03] px-4 py-3 font-sans text-dark-50 placeholder:text-dark-50/40 focus:border-knc-600 focus:outline-none"
          />
        </div>
        <div class="flex flex-col gap-2">
          <label for="empresa" class="font-title text-sm uppercase">
            Empresa
          </label>
          <input
            id="empresa"
            name="empresa"
            type="text"
            placeholder="La tuya o la que te paga"
            class="rounded-2xl border border-white/15 bg-white/[0.03] px-4 py-3 font-sans text-dark-50 placeholder:text-dark-50/40 focus:border-knc-600 focus:outline-none"
          />
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <label for="email" class="font-title text-sm uppercase">Tu email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          placeholder="donde@respondemos.com"
          class="rounded-2xl border border-white/15 bg-white/[0.03] px-4 py-3 font-sans text-dark-50 placeholder:text-dark-50/40 focus:border-knc-600 focus:outline-none"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="tipo" class="font-title text-sm uppercase">
          Qué te interesa
        </label>
        <select
          id="tipo"
          name="tipo"
          class="rounded-2xl border border-white/15 bg-dark-950 px-4 py-3 font-sans text-dark-50 focus:border-knc-600 focus:outline-none"
        >
          <option value="" selected>Elige una opción…</option>
          {formats.map(({ label }) => <option value={label}>{label}</option>)}
          <option value="Otra cosa">Otra cosa (te escuchamos)</option>
        </select>
      </div>

      <div class="flex flex-col gap-2">
        <label for="mensaje" class="font-title text-sm uppercase">
          Tu mensaje
        </label>
        <textarea
          id="mensaje"
          name="mensaje"
          rows="4"
          required
          placeholder="Idea, presupuesto, fechas… lo que sea. Tú suelta, nosotros escuchamos."
          class="rounded-2xl border border-white/15 bg-white/[0.03] px-4 py-3 font-sans text-dark-50 placeholder:text-dark-50/40 focus:border-knc-600 focus:outline-none"
        ></textarea>
      </div>

      <div class="mt-2 flex items-center justify-between gap-4">
        <p id="form-status" class="font-sans text-sm text-dark-50/60" role="status"></p>
        <button
          type="submit"
          id="form-submit"
          class="inline-flex items-center gap-3 rounded-full bg-knc-600 px-8 py-3 text-lg text-dark-50 uppercase transition-transform duration-300 hover:-rotate-2 hover:scale-105"
        >
          Enviar <ArrowRight class="size-5" />
        </button>
      </div>
    </form>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLParagraphElement>("#form-status");
  const submit = document.querySelector<HTMLButtonElement>("#form-submit");

  if (!form || !status || !submit) throw new Error("formulario no encontrado");

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    const data = Object.fromEntries(new FormData(form).entries());
    status.textContent = "Mandando…";
    submit.disabled = true;

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(data),
      });

      const json = await res.json().catch(() => null);

      if (res.ok) {
        status.textContent =
          "¡Bombazo! Hemos recibido tu mensaje. Te respondemos en 48 h.";
        form.reset();
      } else if (res.status === 503) {
        status.textContent =
          "Ups, aún estamos configurando este canal. Escríbenos por redes mientras tanto.";
      } else {
        status.textContent = json?.error ?? "Algo ha fallado. Reinténtalo.";
      }
    } catch {
      status.textContent = "Algo ha fallado. Reinténtalo o escríbenos por redes.";
    } finally {
      submit.disabled = false;
    }
  });
</script>
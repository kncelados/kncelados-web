---
import { kncine } from "@/lib/kncine";
import Prev from "@/lib/assets/Prev.astro";
import Next from "@/lib/assets/Next.astro";

const pages_count = Math.max(1, Math.ceil(kncine.length / 6));
---

<section
  id="kncine-awards"
  class="relative flex w-full flex-col items-center gap-8 px-6 py-20 lg:gap-12 lg:py-32"
>
  <div class="flex flex-col items-center gap-4 text-center">
    <h2 class="text-3xl lg:text-6xl">
      KNCINE <span class="text-knc-600">AWARDS</span>
    </h2>
    <p class="max-w-2xl text-dark-300 text-lg lg:text-2xl">
      Películas que vale la pena ver con nuestro sello de calidad.
    </p>
  </div>

  <div class="relative w-full max-w-5xl px-6 lg:px-12">
    <div class="grid-slider flex w-full overflow-x-auto snap-x snap-mandatory scroll-pl-8 lg:scroll-pl-12">
      {Array.from({ length: pages_count }, (_, page_index) => (
        <div
          class="page-grid grid w-full shrink-0 snap-start gap-4 lg:gap-6 grid-cols-2 lg:grid-cols-3"
        >
          {kncine
            .slice(page_index * 6, page_index * 6 + 6)
            .map((movie) => (
              <div
                class="card group relative aspect-[2/3] overflow-hidden rounded-xl bg-dark-900"
                aria-label={movie.title}
              >
                <img
                  src={movie.src}
                  alt={movie.alt}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                />

                <span
                  class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-dark-950 via-dark-950/70 to-transparent pt-10 pb-3 px-3 text-center"
                >
                  <span class="text-sm lg:text-base font-title uppercase">
                    {movie.title}
                  </span>
                </span>

                <span
                  class="badge absolute top-0 left-2 flex items-center justify-center rounded-b-md bg-dark-950/95 p-0.5 drop-shadow-lg transition-transform duration-500 group-hover:rotate-3 group-hover:scale-110"
                >
                  <img
                    src="/KNCIEN-AWARDS.png"
                    alt="Sello Kncine Awards"
                    class="w-[26px] lg:w-[35px]"
                  />
                </span>
              </div>
            ))}
        </div>
      ))}
    </div>

    <button
      class="prev absolute top-1/2 left-0 z-20 -translate-y-1/2 rounded-full bg-dark-950/70 p-2 text-knc-500 backdrop-blur transition-transform hover:scale-110 sm:p-3"
      aria-label="Anterior"
    >
      <Prev class="w-6 sm:w-8" />
    </button>

    <button
      class="next absolute top-1/2 right-0 z-20 -translate-y-1/2 rounded-full bg-dark-950/70 p-2 text-knc-500 backdrop-blur transition-transform hover:scale-110 sm:p-3"
      aria-label="Siguiente"
    >
      <Next class="w-8" />
    </button>
  </div>

  {pages_count > 1 && (
    <div class="dots flex items-center justify-center gap-2">
      {Array.from({ length: pages_count }, (_, dot_index) => (
        <button
          data-dot-index={dot_index}
          class="w-2 h-2 rounded-full bg-dark-300/50 transition-all duration-300 hover:bg-knc-500/70"
          aria-label={`Ir a la página ${dot_index + 1}`}
        />
      ))}
    </div>
  )}
</section>

<script>
  function init_grid_slider() {
    const slides = document.querySelectorAll(".grid-slider");

    if (!slides) return;

    slides.forEach((slider) => {
      const prev = slider.parentElement?.querySelector(".prev");
      const next = slider.parentElement?.querySelector(".next");
      const dots = slider
        .closest("section")
        ?.querySelector(".dots")
        ?.querySelectorAll("[data-dot-index]");

      if (!prev || !next) return;

      const page = () => slider.querySelector(".page-grid")?.clientWidth ?? 0;

      const update_dots = () => {
        if (!dots?.length) return;
        const index = Math.min(
          dots.length - 1,
          Math.max(0, Math.round(slider.scrollLeft / slider.clientWidth))
        );
        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add("bg-knc-500", "w-4");
            dot.classList.remove("bg-dark-300/40", "w-2");
          } else {
            dot.classList.add("bg-dark-300/40", "w-2");
            dot.classList.remove("bg-knc-500", "w-4");
          }
        });
      };

      prev.addEventListener("click", () => {
        const width = page();
        slider.scrollBy({ left: width > 0 ? -width : -slider.clientWidth, behavior: "smooth" });
      });

      next.addEventListener("click", () => {
        const maxScroll = slider.scrollWidth - slider.clientWidth;
        const width = page();
        const target = Math.min(maxScroll - slider.scrollLeft, width > 0 ? width : slider.clientWidth);
        slider.scrollBy({ left: target, behavior: "smooth" });
      });

      dots?.forEach((dot, index) => {
        dot.addEventListener("click", () => {
          slider.scrollTo({ left: index * slider.clientWidth, behavior: "smooth" });
        });
      });

      slider.addEventListener("scroll", update_dots, { passive: true });
      window.addEventListener("resize", update_dots);
      update_dots();
    });
  }

  init_grid_slider();
  document.addEventListener("astro:after-swap", init_grid_slider);
</script>

<style>
  .grid-slider {
    scrollbar-width: none;
  }

  .grid-slider::-webkit-scrollbar {
    display: none;
  }
</style>
---
const SITGES = {
  place: "Sitges, Barcelona",
  date: "29 de agosto",
  status: "SOLD OUT",
  disabled: true,
  background: "https://i.ytimg.com/vi/5y-y0tXbcSs/maxresdefault.jpg",
  video: "https://www.youtube.com/watch?v=5y-y0tXbcSs",
};

const VALENCIA = {
  place: "Valencia",
  venue: "Teatro Laplazeta",
  date: "13 de junio",
  status: "SOLD OUT",
  disabled: true,
  background: "https://i.ytimg.com/vi/aHLCKXgsU3Q/maxresdefault.jpg",
  video: "https://www.youtube.com/watch?v=aHLCKXgsU3Q",
};

const MADRID = {
  label: "KNCELADOS Madrid",
  date: "29 de noviembre",
  venue: "Palacio de la Prensa",
  background: "/kncelados-podcast.jpg", // placeholder hasta tener imagen real de Madrid
  tickets: "/link/madrid",
};

const NEXT = {
  label: "Próximamente",
  disabled: true,
};
---

<section
  id="shows"
  class="flex w-full flex-col items-center gap-10 bg-knc-600 px-6 py-20 text-dark-950 lg:gap-14 lg:py-32"
>
  <h2 class="text-center text-3xl text-dark-50 lg:text-5xl">
    SHOWS EN VIVO
  </h2>

  <div class="grid w-full max-w-6xl grid-cols-1 gap-6 lg:grid-cols-4 lg:gap-6">
    <!-- Valencia: SOLD OUT, deshabilitado -->
    <article
      class="relative overflow-hidden rounded-3xl bg-dark-950 text-dark-50"
    >
      <img
        src={VALENCIA.background}
        alt="Show de Valencia en el Teatro Laplazeta"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover opacity-50"
      />
      <div
        class="relative z-10 flex aspect-[4/5] flex-col items-center justify-between gap-4 p-6 text-center"
      >
        <span
          class="-rotate-12 rounded-md border-2 border-knc-500 px-4 py-1 font-title text-2xl uppercase text-knc-500"
        >
          {VALENCIA.status}
        </span>

        <div class="flex flex-col items-center gap-1">
          <span class="font-title text-2xl uppercase lg:text-3xl">
            {VALENCIA.place}
          </span>
          <span class="font-sans text-lg opacity-70">{VALENCIA.venue}</span>
          <span class="font-sans text-sm uppercase opacity-60">{VALENCIA.date}</span>
        </div>

        <a
          href={VALENCIA.video}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-knc-600 px-8 py-3 font-title text-base uppercase text-dark-950 transition-transform hover:scale-105"
        >
          Ver
        </a>
      </div>
      <div class="pointer-events-none absolute inset-0 z-20 bg-dark-950/45" />
    </article>

    <!-- Sitges: SOLD OUT, deshabilitado -->
    <article
      class="relative overflow-hidden rounded-3xl bg-dark-950 text-dark-50"
    >
      <img
        src={SITGES.background}
        alt="Show de Sitges en el Chilliboys"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover opacity-50"
      />
      <div
        class="relative z-10 flex aspect-[4/5] flex-col items-center justify-between gap-4 p-6 text-center"
      >
        <span
          class="-rotate-12 rounded-md border-2 border-knc-500 px-4 py-1 font-title text-2xl uppercase text-knc-500"
        >
          {SITGES.status}
        </span>

        <div class="flex flex-col items-center gap-1">
          <span class="font-title text-2xl uppercase lg:text-3xl">
            {SITGES.place}
          </span>
          <span class="font-sans text-lg opacity-70">{SITGES.date}</span>
        </div>

        <a
          href={SITGES.video}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-knc-600 px-8 py-3 font-title text-base uppercase text-dark-950 transition-transform hover:scale-105"
        >
          Ver
        </a>
      </div>
      <div class="pointer-events-none absolute inset-0 z-20 bg-dark-950/45" />
    </article>

    <!-- Madrid: activo -->
    <article
      class="relative overflow-hidden rounded-3xl bg-dark-950 text-dark-50"
    >
      <img
        src={MADRID.background}
        alt="Show de Kncelados en Madrid, Palacio de la Prensa"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover opacity-50"
      />
      <div
        class="relative z-10 flex aspect-[4/5] flex-col items-center justify-between gap-4 p-6 text-center"
      >
        <div class="flex flex-col items-center gap-1">
          <span class="font-title text-2xl uppercase lg:text-3xl">
            {MADRID.label}
          </span>
          <span class="font-sans text-lg">{MADRID.date}</span>
          <span class="font-sans text-sm uppercase opacity-70">
            {MADRID.venue}
          </span>
        </div>

        <a
          href={MADRID.tickets}
          class="rounded-full bg-knc-600 px-8 py-3 font-title text-base uppercase text-dark-950 transition-transform hover:scale-105"
        >
          Tickets
        </a>
      </div>
    </article>

    <!-- Próximamente: bloqueado -->
    <article
      class="relative flex aspect-[4/5] flex-col items-center justify-center gap-4 rounded-3xl border-2 border-dashed border-dark-950/40 p-6 text-center opacity-80"
    >
      <span class="font-title text-3xl uppercase">Próximamente</span>
      <span class="font-sans text-lg opacity-60">
        Nuevo show en camino…
      </span>
    </article>
  </div>
</section>
---
import Link from "@/components/Link.astro";
import FlipCard from "@/components/FlipCard.astro";
---

<section
  class="bg-knc-600 text-dark-950 px-6 py-24 lg:py-32 flex flex-col gap-4 lg:gap-12 items-center"
  data-flip-clock
>
  <div
    class="flex scale-90 items-center justify-center gap-3 lg:gap-8 text-lg lg:text-6xl font-bold font-title"
  >
    <FlipCard unit="days" label="Días" />
    <FlipCard unit="hours" label="Horas" />
    <FlipCard unit="minutes" label="Minutos" />
  </div>

  <p class="text-lg lg:text-4xl text-center px-4">
    Si sobrevives al lunes, nos vemos a las ocho
  </p>

  <div class="flex items-center gap-4 mt-2 lg:mt-8">
    <Link href="/podcast" label="Ver podcast" bgColor="bg-dark-950" textColor="text-dark-50" />
  </div>
</section>

<script>
  import { startFlipClock } from "@/scripts/flipclock";

  const root = document.querySelector("[data-flip-clock]");
  if (root instanceof HTMLElement) {
    startFlipClock(root);
  }
</script>

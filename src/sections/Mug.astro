---
import Link from "@/components/Link.astro";
---

<section class="py-24 lg:py-48 px-4 lg:px-6 flex flex-col items-center relative z-10">
  <article
    class="w-full max-w-6xl flex flex-col lg:flex-row justify-center gap-12 lg:gap-24 items-center bg-knc-600 rounded-3xl p-6 lg:p-0"
  >
    <div class="flex flex-col items-center gap-4 -mt-12 lg:mt-0">
      <img
        src="/taza1.webp"
        alt="Taza Kncelados"
        class="h-48 lg:h-80 scale-150 lg:scale-175 -rotate-12"
      />
    </div>

    <div class="flex flex-col items-center lg:items-start gap-6 lg:gap-8 p-0 lg:p-12 text-center lg:text-left">
      <h2 class="text-4xl lg:text-7xl font-bold leading-tight">
        LA P<span class="text-dark-950">*</span>TA<br />QUE GUAPA
      </h2>

      <Link
        href="https://kncelados.myshopify.com/products/taza-roja"
        label="Consigue la tuya"
        bgColor="bg-dark-50"
        textColor="text-dark-950"
        target="_blank"
      />
    </div>
  </article>
</section>

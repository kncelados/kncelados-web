---
import Link from "@/components/Link.astro";
import Youtube from "@/lib/assets/Youtube.astro";
import Spotify from "@/lib/assets/Spotify.astro";
import Instagram from "@/lib/assets/Instagram.astro";
import Tiktok from "@/lib/assets/Tiktok.astro";
---

<section
  class="relative aspect-video w-full flex flex-col items-center justify-center"
>
  <div
    id="video-container"
    class="absolute bg-dark-950 inset-0 w-full z-[-1] flex items-baseline justify-center"
  >
    <video
      src="/intro.webm"
      playsinline
      autoplay
      muted
      loop
      class="size-full object-cover opacity-20"></video>
  </div>

  <p class="text-center max-w-4xl px-4 font-normal text-2xl lg:text-5xl leading-tight">
    Cuatro amigos, un podcast, <span class="text-knc-600 font-semibold">cero filtros</span>
  </p>

  <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row lg:gap-6">
    <Link
      href="https://www.youtube.com/@kncelados"
      label="YouTube"
      icon={Youtube}
      target="_blank"
    />
    <Link
      href="https://open.spotify.com/show/5bDQAbJUSdfHYdii8A8eX0"
      label="Spotify"
      icon={Spotify}
      target="_blank"
    />
    <Link
      href="https://www.instagram.com/kncelados"
      label="Instagram"
      icon={Instagram}
      target="_blank"
    />
    <Link
      href="https://www.tiktok.com/@kncelados"
      label="TikTok"
      icon={Tiktok}
      target="_blank"
    />
  </div>
</section>

<style>
  #video-container {
    mask-image: linear-gradient(
      0deg,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }
</style>

---
import Link from "@/components/Link.astro";
import { ArrowRight } from "@lucide/astro";
---

<section
  class="relative flex w-full flex-col items-center gap-8 overflow-clip bg-knc-600 py-24 text-dark-950 lg:py-40 lg:gap-10"
>
  <h2 class="text-center text-5xl lg:text-8xl">¿HABLAMOS?</h2>
  <p class="max-w-2xl px-6 text-center font-sans text-lg text-dark-950/85 lg:text-2xl">
    Tu marca, dentro de la conversación. Sin burocracia, sin intermediarios y
    sin darle más vueltas.
  </p>
  <Link
    href="/contacto"
    label="Colabora con nosotros"
    bgColor="bg-dark-950"
    textColor="text-knc-600"
    icon={ArrowRight}
  />
  <p
    aria-hidden="true"
    class="pointer-events-none select-none text-center font-title text-[16vw] leading-none opacity-10 lg:text-[12vw]"
  >
    KNCELADOS
  </p>
</section>
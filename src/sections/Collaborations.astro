---
import Link from "@/components/Link.astro";
import { metrics } from "@/lib/commercial";
import { ArrowRight } from "@lucide/astro";
---

<section class="flex w-full flex-col items-center gap-8 px-6 py-20 lg:py-32 lg:gap-12">
  <h2 class="max-w-3xl text-center text-3xl lg:text-6xl">
    METE TU MARCA<br />EN LA CONVERSACIÓN
  </h2>

  <p class="max-w-2xl text-center font-sans text-lg text-dark-50/75 lg:text-xl">
    Colaboramos con marcas que entienden que el humor mueve más que el
    storytelling. Sin guion corporativo, sin corbata y sin postureo: tu marca
    entra en el grupo del WhatsApp y se hace querer.
  </p>

  <div class="grid w-full max-w-4xl grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-6">
    {
      metrics.map(({ value, label, source }) => (
        <div class="flex flex-col gap-1 rounded-3xl border border-white/10 bg-white/[0.03] p-4 text-center">
          <span class="font-title text-2xl text-knc-600 lg:text-3xl">{value}</span>
          <span class="font-sans text-xs text-dark-50/80 lg:text-sm">{label}</span>
          <span class="font-title text-[0.55rem] uppercase text-dark-50/40 lg:text-[0.6rem]">
            {source}
          </span>
        </div>
      ))
    }
  </div>

  <div class="grid w-full max-w-4xl grid-cols-1 gap-4 sm:grid-cols-3 lg:gap-6">
    <div class="flex flex-col gap-2 rounded-3xl bg-knc-600/10 p-6">
      <h3 class="text-lg lg:text-xl">Presencia real</h3>
      <p class="font-sans text-sm leading-relaxed text-dark-50/70">
        No te lee un locutor. Te ve una comunidad que espera el episodio cada
        lunes a las 20:00 h.
      </p>
    </div>
    <div class="flex flex-col gap-2 rounded-3xl bg-knc-600/10 p-6">
      <h3 class="text-lg lg:text-xl">Formato nativo</h3>
      <p class="font-sans text-sm leading-relaxed text-dark-50/70">
        Patrocinio, integración, clips y acciones. El mensaje se adapta al
        tono, no al revés.
      </p>
    </div>
    <div class="flex flex-col gap-2 rounded-3xl bg-knc-600/10 p-6">
      <h3 class="text-lg lg:text-xl">Resultados medibles</h3>
      <p class="font-sans text-sm leading-relaxed text-dark-50/70">
        Cada colaboración con sus números encima de la mesa. Sin humo.
      </p>
    </div>
  </div>

  <Link
    href="/contacto"
    label="Hablemos"
    bgColor="bg-knc-600"
    textColor="text-dark-950"
    icon={ArrowRight}
  />
</section>
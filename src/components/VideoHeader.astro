---
import "@fontsource-variable/inter";
import { generateSlug } from "@/lib/utils";

const { data } = Astro.props;
const { title, name, description, image, url, id, season, episode } = data;
const { pathname } = Astro.url;
---

<Fragment slot="head">
  <link rel="preload" href={image} as="image" />
</Fragment>

<section class="flex size-full flex-col items-center gap-8">
  <article
    class="relative flex size-full flex-col items-center justify-end lg:justify-center"
  >
    <img
      class="absolute size-full object-cover object-top"
      src={image}
      alt={title}
    />

    <picture
      class:list={[
        "z-20 px-4",
        pathname === "/shorts" ? "inline lg:hidden" : "hidden",
      ]}
    >
      <img src={image} alt={title} class="rounded-xl" />
    </picture>

    <span
      class="from-dark-950/85 absolute inset-0 bg-gradient-to-r from-20% to-transparent"
    ></span>

    <span
      class="from-transparent to-dark-950 absolute inset-0 bg-gradient-to-b"
    ></span>

    <div
      class:list={[
        "z-20 flex w-full flex-col justify-center px-6 pb-6 lg:mt-48 lg:px-20 lg:pb-20",
        pathname === "/shorts" ? "my-12" : "mt-32",
      ]}
    >
      {
        name && (
          <p class="pl-2 text-sm text-dark-400 mb-4">
            EP {episode} · T{season}
          </p>
        )
      }

      <h1 class="max-w-3xl text-4xl capitalize lg:text-7xl">
        {name ? name.toLowerCase() : title}
      </h1>

      <div class="mt-4 flex lg:mt-10">
        <a
          href={`/player/${id}`}
          class="bg-knc-600 rounded-xl px-8 py-3 transition-transform hover:scale-110"
        >
          Ver aquí
        </a>

        <a
          href={url}
          target="_blank"
          class="px-8 py-3 transition-transform hover:scale-110"
        >
          Ver en YouTube
        </a>
      </div>

      <p class="mt-6 line-clamp-4 max-w-[60ch] text-dark-100 lg:mt-12 lg:text-lg">
        {description}
      </p>
    </div>
  </article>
</section>

<style>
  p {
    font-family:
      "Inter Variable",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }
</style>
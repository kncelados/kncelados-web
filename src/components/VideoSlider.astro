---
import VideoCard from "@/components/VideoCard.astro";
import Prev from "@/lib/assets/Prev.astro";
import Next from "@/lib/assets/Next.astro";

const { data, title, id } = Astro.props;
const current_season = data[0].season;
---

<section id={id} class="relative flex w-full flex-col pt-4 lg:pt-8">
  <h2 class="px-6 text-xl lg:px-20 lg:text-3xl">
    {title || `Temporada ${current_season}`}
  </h2>

  <div class="relative">
    <div
      class="slider snap flex h-44 w-full snap-x snap-proximity items-center gap-1 overflow-x-auto pl-6 pr-6 lg:h-72 lg:pl-20 lg:pr-20"
    >
      {data.map((episode) => <VideoCard data={episode} />)}
    </div>

    <button
      class="prev absolute top-1/2 left-0 z-20 hidden -translate-y-1/2 rounded-full bg-dark-950/70 p-2 text-knc-500 backdrop-blur transition-transform hover:scale-110 lg:inline-flex sm:p-3"
      aria-label="Anterior"
    >
      <Prev class="w-6 sm:w-8" />
    </button>

    <button
      class="next absolute top-1/2 right-0 z-20 hidden -translate-y-1/2 rounded-full bg-dark-950/70 p-2 text-knc-500 backdrop-blur transition-transform hover:scale-110 lg:inline-flex sm:p-3"
      aria-label="Siguiente"
    >
      <Next class="w-6 sm:w-8" />
    </button>
  </div>
</section>

<script>
  function init_slider() {
    const sliders = document.querySelectorAll(".slider");

    if (!sliders) return;

    sliders.forEach((slider) => {
      const slide = slider.querySelector("article");
      const prev = slider.parentElement?.querySelector(".prev");
      const next = slider.parentElement?.querySelector(".next");

      if (!slide || !prev || !next) return;

      prev.addEventListener("click", () => {
        slider.scrollBy({
          left: Math.max(0 - slider.scrollLeft, -slide.clientWidth),
          behavior: "smooth",
        });
      });

      next.addEventListener("click", () => {
        const maxScroll = slider.scrollWidth - slider.clientWidth;
        slider.scrollBy({
          left: Math.min(maxScroll - slider.scrollLeft, slide.clientWidth),
          behavior: "smooth",
        });
      });
    });
  }

  init_slider();
  document.addEventListener("astro:after-swap", init_slider);
</script>

<style>
  .slider {
    scrollbar-width: none;
  }
</style>
